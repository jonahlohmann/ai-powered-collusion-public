+def build_price_table(
+    n_p: int,
+    v_grid: np.ndarray,
+    n_agents: int,
+    xi: float,
+    sigma_u: float,
+    theta: float,
+    sigma_v: float = 1.0,
+    v_bar: float = 0.0,
+    iota: float = _DEFAULT_IOTA,
+) -> np.ndarray:
+    """One price grid per value state (paper §4.2 read per value; footnote 25).
+
+    Row k is the grid for prices set in a period whose value is ``v_k``:
+
+        p_H(k) = v̄ + λ^N · (max{I·χ^M·dv_k, I·χ^N·dv_k} + 1.96 · σ_u)
+        p_L(k) = v̄ + λ^N · (min{I·χ^M·dv_k, I·χ^N·dv_k} − 1.96 · σ_u)
+
+    with ``dv_k = v_k − v̄``, discretised over
+    ``[p_L − ι(p_H − p_L), p_H + ι(p_H − p_L)]`` into ``n_p`` points. With
+    ``n_p ≈ 2 n_x`` and two speculators, one level on the per-v action grid
+    then moves the price by about one grid step (paper footnote 25).
+
+    Args:
+        n_p: Number of grid points per row (must be ≥ 2).
+        v_grid: 1D array of value grid points.
+        n_agents: Number of strategic informed speculators (paper symbol I).
+        xi: Demand elasticity of information-insensitive investors.
+        sigma_u: Standard deviation of noise trader order flow.
+        theta: Market-maker inventory penalty.
+        sigma_v: Standard deviation of fundamental value.
+        v_bar: Mean of the fundamental value.
+        iota: Padding factor on the interval width (paper ι = 0.1).
+
+    Returns:
+        Array of shape ``(len(v_grid), n_p)``; every row ascending.
+    """
+    if n_p < 2:
+        raise ValueError(f"n_p must be ≥ 2, got {n_p}.")
+    chi_n = benchmarks.x_N(n_agents, xi, sigma_u, theta, sigma_v)
+    chi_m = benchmarks.x_M(n_agents, xi, sigma_u, theta, sigma_v)
+    lam_n = benchmarks.lambda_N(n_agents, xi, sigma_u, theta, sigma_v)
+    v_arr = np.asarray(v_grid, dtype=np.float64)
+    table = np.empty((len(v_arr), n_p), dtype=np.float64)
+    for k, v_k in enumerate(v_arr):
+        dv = float(v_k - v_bar)
+        y_n = n_agents * chi_n * dv
+        y_m = n_agents * chi_m * dv
+        p_high = v_bar + lam_n * (max(y_n, y_m) + 1.96 * sigma_u)
+        p_low = v_bar + lam_n * (min(y_n, y_m) - 1.96 * sigma_u)
+        pad = iota * (p_high - p_low)
+        table[k] = np.linspace(p_low - pad, p_high + pad, n_p, dtype=np.float64)
+    return table
+
+
