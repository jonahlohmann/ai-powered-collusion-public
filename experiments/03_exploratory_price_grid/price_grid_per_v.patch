+    def _price_bin(self, price: float, v_bin: int) -> tuple[int, float]:
+        """Bin index and grid value of ``price`` set in a period with value ``v_bin``.
+
+        Global grid: nearest point of ``price_grid``. Per-v grid: nearest point
+        of row ``v_bin`` of ``price_table`` (out-of-range prices map to the
+        nearest endpoint); the centre bin at the value that equals v̄.
+
+        Args:
+            price: Raw clearing price.
+            v_bin: Index of the value of the period in which the price was set.
+
+        Returns:
+            Tuple ``(bin_index, grid_value)``.
+        """
+        if self.price_table is None:
+            b = continuous_to_bin(price, self.price_grid)
+            return b, float(self.price_grid[b])
+        if self._v_degenerate[v_bin]:
+            b = self._n_p // 2
+        else:
+            b = int(round((price - self._p_lo[v_bin]) / self._p_step[v_bin]))
+            b = min(max(b, 0), self._n_p - 1)
+        return b, float(self.price_table[v_bin, b])
+
